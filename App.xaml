<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AvataRunway.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AvataRunway">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SettingsOverlayScrimBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="SettingsModalBackgroundBrush" Color="#FF282828" />
                    <SolidColorBrush x:Key="SettingsSidebarBackgroundBrush" Color="#FF242424" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SettingsOverlayScrimBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="SettingsModalBackgroundBrush" Color="#FF282828" />
                    <SolidColorBrush x:Key="SettingsSidebarBackgroundBrush" Color="#FF242424" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SettingsOverlayScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SettingsModalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SettingsSidebarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
